// Example: basic benchmarks using Odin bindings to google-benchmark.
//
// Build and run:
//   cd bindings/odin
//   odin build examples -out:basic_example
//   ./basic_example

package basic_example

import benchmark ".."
import "core:os"

// ---- Benchmark functions ----

BM_empty :: proc(state: *benchmark.State) void {
    for state.keep_running() {}
}

BM_with_batch :: proc(state: *benchmark.State) void {
    for state.keep_running_batch(64) {}
}

BM_memory_write :: proc(state: *benchmark.State) void {
    n := state.range(0)
    buf := make([]u8, int(n), context.allocator) catch return
    defer free(buf, context.allocator)

    for state.keep_running() {
        for b in buf {
            buf[b] = 0x42
        }
    }
    state.set_bytes_processed(n * state.iterations())
}

BM_sort :: proc(state: *benchmark.State) void {
    n := state.range(0)
    arr := make([]i32, int(n), context.allocator) catch return
    defer free(arr, context.allocator)

    for a, i in arr {
        arr[a] = int(n - i)
    }

    for state.keep_running() {
        // Sort would go here
    }
}

// ---- Main ----

main :: proc() {
    benchmark.initialize(os.args_v[0..])

    benchmark.register("BM_empty", BM_empty, {})

    bm_batch := benchmark.register("BM_with_batch", BM_with_batch, {})
    _ = bm_batch

    bm_mem := benchmark.register("BM_memory_write", BM_memory_write, {})
    _ = bm_mem.range(1 << 10, 1 << 20).use_real_time()

    bm_sort := benchmark.register("BM_sort", BM_sort, {})
    _ = bm_sort.range(1 << 0, 1 << 12).unit(.microsecond).use_real_time()

    _ = benchmark.run()
}
